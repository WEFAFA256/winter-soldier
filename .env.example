# Copy to .env.local and fill in real values. Never commit .env.local.

# Cloudinary (server-side; used by /api/content, /api/gallery, /api/blog, /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public cloud name for read-only image URLs, if needed by client code
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Public site URL used for canonical/OG URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Admin authentication (server-side only)
# ADMIN_PASSKEY is what you type into /admin/gallery.
ADMIN_PASSKEY=
# Long random string used to sign the HttpOnly session cookie.
ADMIN_SESSION_SECRET=

# Worker payments API (used by the server-side bookings proxy)
PAY_API_URL=https://serenity-pawapay-webhook.turyatembajohn905.workers.dev
# Token for admin-only Worker endpoints (list/manage bookings)
ADMIN_API_TOKEN=
