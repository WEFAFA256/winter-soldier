# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL used for canonical/OG URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.executiveserenityspa.com

# Admin authentication (server-side only)
# ADMIN_PASSKEY is what you type into /admin/gallery.
ADMIN_PASSKEY=
# Long random string used to sign the HttpOnly session cookie.
ADMIN_SESSION_SECRET=

# Worker payments & R2 Media API — TWO names for TWO different consumers (both required):
#   PAY_API_URL            server-side only, used by /api/content, /api/gallery, /api/blog,
#                          /api/admin/bookings and /api/admin/refunds proxies.
#   NEXT_PUBLIC_PAY_API_URL browser-side, used by /booking for services,
#                          availability, booking and MoMo prompts. The NEXT_PUBLIC_
#                          prefix is REQUIRED for client bundles to see it.
# If you move the Worker host, update BOTH values and rebuild (CSP connect-src
# is derived from NEXT_PUBLIC_PAY_API_URL at build time).
PAY_API_URL=https://serenity-pawapay-webhook.turyatembajohn905.workers.dev
NEXT_PUBLIC_PAY_API_URL=https://serenity-pawapay-webhook.turyatembajohn905.workers.dev
# Token for admin-only Worker endpoints (list/manage bookings, R2 upload tickets)
ADMIN_API_TOKEN=
# Optional emergency kill switch: change to any new value to invalidate EVERY
# signed admin session at once (requires a redeploy). Defaults to "1".
ADMIN_SESSION_VERSION=1
